# Copy this file to .env and fill in real values. Never commit .env.

# --- Identity ---
AGENT_NAME=Jarvis
TRIGGER_HOTKEY=<cmd>+z

# --- Execution mode: OFFLINE (local Whisper/Piper) or ONLINE (remote API fallback) ---
EXECUTION_MODE=OFFLINE

# --- Whisper / Piper ---
WHISPER_MODEL_SIZE=base
PIPER_VOICE_MODEL=en_US-lessac-medium

# --- Local status dashboard (http://127.0.0.1:<port>/) ---
DASHBOARD_PORT=8765

# --- Telegram approval bridge ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Anthropic / Claude Code (used headlessly by the watchdog) ---
ANTHROPIC_API_KEY=

# --- Social platform credentials (modules/social_poster.py) ---
# YouTube: OAuth2 installed-app flow, Data API v3. No app review needed
# for your own channel.
YOUTUBE_OAUTH_ACCESS_TOKEN=

# TikTok: Content Posting API. Public posting requires an audited app --
# unaudited apps are limited to draft/private uploads.
TIKTOK_ACCESS_TOKEN=

# Facebook Page + Instagram Business (Meta Graph API). Public posting and
# comment auto-replies require Meta App Review + business verification.
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
