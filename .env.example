# Copy this file to .env and fill in real values. Never commit .env.

# --- Identity ---
AGENT_NAME=Jarvis
TRIGGER_HOTKEY=<cmd>+z
# Off by default: pynput's global hotkey listener is X11-based and
# generally can't receive keypresses on GNOME/Wayland (or Wayland
# compositors in general) unless this process's own window has focus.
# The wake word doesn't have this problem. Set true only on X11, or a
# Wayland setup where you've confirmed the hotkey actually fires.
ENABLE_HOTKEY_TRIGGER=false

# --- Execution mode: OFFLINE (local Whisper/Piper) or ONLINE (remote API fallback) ---
EXECUTION_MODE=OFFLINE

# --- Whisper / Piper ---
WHISPER_MODEL_SIZE=base.en
PIPER_VOICE_MODEL=en_US-lessac-medium

# --- Local status dashboard (http://127.0.0.1:<port>/) ---
DASHBOARD_PORT=8765

# --- Telegram approval bridge ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Anthropic / Claude Code (used headlessly by the watchdog, and as a
# general-conversation provider if set -- see CHAT_PROVIDER_ORDER below) ---
ANTHROPIC_API_KEY=

# --- General conversation providers (core/chat_engine.py) ---
# Only providers with a key set are used, tried in this order with
# fallback to the next on failure. Reorder/trim as you like.
CHAT_PROVIDER_ORDER=claude,groq,openai,qwen,kimi

# Groq: https://console.groq.com/keys -- genuinely free tier, hosts Llama.
GROQ_API_KEY=

# OpenAI ("ChatGPT"): https://platform.openai.com/api-keys -- paid.
OPENAI_API_KEY=

# Qwen (Alibaba DashScope, OpenAI-compatible mode):
# https://dashscope.console.aliyun.com/apiKey -- free trial credits.
QWEN_API_KEY=

# Kimi (Moonshot AI): https://platform.moonshot.ai/console/api-keys --
# free trial credits.
KIMI_API_KEY=

# --- Social platform credentials (modules/social_poster.py) ---
# YouTube: OAuth2 installed-app flow, Data API v3. No app review needed
# for your own channel.
YOUTUBE_OAUTH_ACCESS_TOKEN=

# TikTok: Content Posting API. Public posting requires an audited app --
# unaudited apps are limited to draft/private uploads.
TIKTOK_ACCESS_TOKEN=

# Facebook Page + Instagram Business (Meta Graph API). Public posting and
# comment auto-replies require Meta App Review + business verification.
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
