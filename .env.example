# Copy this file to .env and fill in real values. Never commit .env.

# --- Identity ---
AGENT_NAME=Jarvis
TRIGGER_HOTKEY=<cmd>+z

# --- Execution mode: OFFLINE (local Whisper/Piper) or ONLINE (remote API fallback) ---
EXECUTION_MODE=OFFLINE

# --- Whisper / Piper ---
WHISPER_MODEL_SIZE=base
PIPER_VOICE_MODEL=en_US-lessac-medium

# --- Telegram approval bridge ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Anthropic / Claude Code (used headlessly by the watchdog) ---
ANTHROPIC_API_KEY=
